{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 600,
  "network": {
    "allowedDomains": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "allowRead": [
      ".",
      "~/.config",
      "~/.local",
      "Library",
      "~/Library/Keychains"
    ],
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
